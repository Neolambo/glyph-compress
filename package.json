{
  "name": "glyph-compress",
  "version": "1.18.0",
  "description": "Semantic compression for IDE↔LLM communication using radical glyphs. Save 80%+ tokens.",
  "type": "module",
  "bin": {
    "glyph-compress": "bin/cli.js",
    "glyph-compress-mcp": "bin/mcp-server.js"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    },
    "./middleware": {
      "types": "./src/index.d.ts",
      "import": "./src/glyph-middleware.js",
      "require": "./vscode-ext/glyph-middleware.cjs"
    }
  },
  "files": [
    "bin/",
    "src/",
    "vscode-ext/extension.js",
    "vscode-ext/glyph-middleware.cjs",
    "vscode-ext/glyph-middleware.d.ts",
    "vscode-ext/token-estimator.cjs",
    "vscode-ext/proxy.js",
    "vscode-ext/LICENSE",
    "vscode-ext/package.json",
    "README.md",
    "ROADMAP.md",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "NOTICE",
    "SECURITY.md",
    "PRIVACY.md",
    "ENTERPRISE.md",
    "CONTRIBUTING.md",
    "docs/architecture.md",
    "docs/licensing.md",
    "docs/release.md",
    "docs/wiki/",
    "scripts/check-links.js",
    "scripts/publish-wiki.ps1"
  ],
  "scripts": {
    "test": "node test/run-suites.js",
    "test:unit": "node test/unit.js",
    "test:cli": "node test/cli.js",
    "test:workspace": "node test/workspace.js",
    "test:extension": "node test/extension.js",
    "test:proxy": "node test/proxy.js",
    "test:metadata": "node test/metadata.js",
    "test:snapshots": "node test/snapshots.js",
    "test:codebook": "node test/codebook-completeness.js",
    "calibrate:tokenizer": "node test/tokenizer-calibration.js",
    "test:auto-level": "node test/auto-level.js",
    "test:cache-prefix": "node test/cache-prefix-stability.js",
    "test:tech-glyph-economics": "node test/tech-glyph-economics.js",
    "test:context-router": "node test/context-router.js",
    "test:mcp-server": "node test/mcp-server.js",
    "test:team-codebook": "node test/team-codebook.js",
    "test:integration": "node test/integration.js",
    "benchmark": "node test/benchmark.js",
    "benchmark:realistic": "node test/benchmark-realistic.js",
    "demo": "node test/demo.js",
    "build:middleware": "node scripts/build-middleware.js",
    "check": "npm run build:middleware && npm test && npm run benchmark && npm run check:links && npm pack --dry-run",
    "package:vscode": "cd vscode-ext && npx @vscode/vsce package --allow-missing-repository",
    "check:links": "node scripts/check-links.js",
    "release:prepare": "node scripts/release-helper.js"
  },
  "keywords": [
    "compression",
    "llm",
    "token",
    "semantic",
    "glyph",
    "openai",
    "anthropic",
    "claude",
    "vscode",
    "ide",
    "cost-optimization",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Neolambo <campiossasco1@gmail.com>",
  "license": "AGPL-3.0-only",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Neolambo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neolambo/glyph-compress.git"
  },
  "homepage": "https://github.com/Neolambo/glyph-compress#readme",
  "bugs": {
    "url": "https://github.com/Neolambo/glyph-compress/issues"
  },
  "devDependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
