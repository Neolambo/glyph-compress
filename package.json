{
  "name": "glyph-compress",
  "version": "1.32.6",
  "description": "Semantic compression for IDE↔LLM communication using radical glyphs — CLI, MCP server, and VS Code extension, with a Context Router, team-shared dictionaries, and compression calibrated against real provider tokenizers.",
  "mcpName": "io.github.Neolambo/glyph-compress",
  "type": "module",
  "bin": {
    "glyph-compress": "bin/cli.js",
    "glyph-compress-mcp": "bin/mcp-server.js"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    },
    "./middleware": {
      "types": "./src/index.d.ts",
      "import": "./src/glyph-middleware.js",
      "require": "./vscode-ext/glyph-middleware.cjs"
    }
  },
  "files": [
    "bin/",
    "src/",
    "vscode-ext/extension.js",
    "vscode-ext/glyph-middleware.cjs",
    "vscode-ext/glyph-middleware.d.ts",
    "vscode-ext/token-estimator.cjs",
    "vscode-ext/workspace-intelligence.cjs",
    "vscode-ext/team-codebook.cjs",
    "vscode-ext/proxy.js",
    "vscode-ext/LICENSE",
    "vscode-ext/package.json",
    "README.md",
    "ROADMAP.md",
    "server.json",
    "llms.txt",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "NOTICE",
    "SECURITY.md",
    "PRIVACY.md",
    "ENTERPRISE.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CASE_STUDY.md",
    "docs/architecture.md",
    "docs/benchmark-methodology.md",
    "docs/licensing.md",
    "docs/release.md",
    "docs/wiki/",
    "scripts/check-links.js",
    "scripts/publish-wiki.ps1"
  ],
  "scripts": {
    "test": "node test/run-suites.js",
    "test:unit": "node test/unit.js",
    "test:cli": "node test/cli.js",
    "test:workspace": "node test/workspace.js",
    "test:extension": "node test/extension.js",
    "test:proxy": "node test/proxy.js",
    "test:metadata": "node test/metadata.js",
    "test:snapshots": "node test/snapshots.js",
    "test:holographic": "node test/holographic-test.js",
    "test:intent": "node test/intent-test.js",
    "test:codebook": "node test/codebook-completeness.js",
    "test:auto-level": "node test/auto-level.js",
    "test:cache-prefix": "node test/cache-prefix-stability.js",
    "test:tech-glyph-economics": "node test/tech-glyph-economics.js",
    "test:context-router": "node test/context-router.js",
    "test:mcp-server": "node test/mcp-server.js",
    "test:budget-planner": "node test/context-budget-planner.js",
    "test:privacy-redaction": "node test/privacy-redaction.js",
    "test:dashboard": "node test/dashboard.js",
    "test:proxy-inference": "node test/proxy-provider-inference.js",
    "test:team-codebook": "node test/team-codebook.js",
    "test:logger": "node test/logger.js",
    "test:ast-spans": "node test/ast-spans.js",
    "test:code-minify-economics": "node test/code-minify-economics.js",
    "test:trust-warnings": "node test/trust-warnings.js",
    "test:npm-pack-smoke": "node test/npm-pack-smoke.js",
    "test:integration": "node test/integration.js",
    "calibrate:tokenizer": "node test/tokenizer-calibration.js",
    "calibrate:tokenizer:gemini": "node test/tokenizer-calibration-gemini.js",
    "calibrate:tokenizer:anthropic": "node test/tokenizer-calibration-anthropic.js",
    "check:comprehension:gemini": "node test/comprehension-check-gemini.js",
    "check:comprehension:openai": "node test/comprehension-check-openai.js",
    "check:comprehension:anthropic": "node test/comprehension-check-anthropic.js",
    "benchmark": "node test/benchmark.js",
    "benchmark:realistic": "node test/benchmark-realistic.js",
    "benchmark:alternatives": "node test/benchmark-alternatives.js",
    "demo": "node test/demo.js",
    "build:middleware": "node scripts/build-middleware.js",
    "check": "npm run build:middleware && npm test && npm run benchmark && npm run check:links && npm pack --dry-run",
    "package:vscode": "cd vscode-ext && npx @vscode/vsce package",
    "check:links": "node scripts/check-links.js",
    "release:prepare": "node scripts/release-helper.js"
  },
  "keywords": [
    "compression",
    "llm",
    "token",
    "semantic",
    "glyph",
    "openai",
