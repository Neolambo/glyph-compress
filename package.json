{
  "name": "glyph-compress",
  "version": "0.5.3",
  "description": "Semantic compression for IDE↔LLM communication using radical glyphs. Save 80%+ tokens.",
  "type": "module",
  "bin": {
    "glyph-compress": "bin/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    },
    "./middleware": {
      "import": "./vscode-ext/glyph-middleware.js",
      "require": "./vscode-ext/glyph-middleware.cjs"
    }
  },
  "scripts": {
    "test": "node test/integration.js",
    "demo": "node test/demo.js"
  },
  "keywords": [
    "compression",
    "llm",
    "token",
    "semantic",
    "glyph",
    "openai",
    "anthropic",
    "claude",
    "vscode",
    "ide",
    "cost-optimization"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Neolambo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Neolambo/glyph-compress.git"
  },
  "homepage": "https://github.com/Neolambo/glyph-compress#readme",
  "bugs": {
    "url": "https://github.com/Neolambo/glyph-compress/issues"
  }
}
