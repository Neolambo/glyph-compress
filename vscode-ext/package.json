{
  "name": "glyph-compress",
  "displayName": "GlyphCompress — Semantic Token Compression",
  "description": "Compress IDE↔LLM communication using semantic radicals. Saves 80%+ tokens with OpenAI, Claude, and Antigravity.",
  "version": "0.5.1",
  "license": "AGPL-3.0",
  "publisher": "Neolambo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "glyphCompress.buildCodebook",
        "title": "GlyphCompress: Build Project Codebook"
      },
      {
        "command": "glyphCompress.showStats",
        "title": "GlyphCompress: Show Compression Stats"
      },
      {
        "command": "glyphCompress.toggle",
        "title": "GlyphCompress: Toggle Compression On/Off"
      },
      {
        "command": "glyphCompress.compressSelection",
        "title": "GlyphCompress: Compress Selection"
      },
      {
        "command": "glyphCompress.copyCodebook",
        "title": "GlyphCompress: Copy System Codebook"
      },
      {
        "command": "glyphCompress.askChat",
        "title": "GlyphCompress: Ask LLM (Auto-Compress)"
      },
      {
        "command": "glyphCompress.startProxy",
        "title": "GlyphCompress: Start Zero-Command Proxy"
      },
      {
        "command": "glyphCompress.stopProxy",
        "title": "GlyphCompress: Stop Zero-Command Proxy"
      }
    ],
    "keybindings": [
      {
        "command": "glyphCompress.askChat",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "GlyphCompress",
      "properties": {
        "glyphCompress.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable GlyphCompress compression"
        },
        "glyphCompress.provider": {
          "type": "string",
          "enum": [
            "auto",
            "openai",
            "anthropic",
            "antigravity"
          ],
          "default": "auto",
          "description": "LLM provider to optimize for"
        },
        "glyphCompress.compressionLevel": {
          "type": "string",
          "enum": [
            "light",
            "standard",
            "aggressive"
          ],
          "default": "standard",
          "description": "Compression aggressiveness (light=prompts only, standard=+files, aggressive=+full code→semantic)"
        },
        "glyphCompress.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show compression stats in status bar"
        }
      }
    }
  },
  "scripts": {
    "test": "node test.js"
  },
  "dependencies": {
    "@types/vscode": "^1.116.0"
  }
}
